+/// The modifier keys last reported to the application, as `ModifiersState` bits.
+static MODIFIERS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+/// The modifier keys that Android says are held, from the meta state of an input event.
+fn modifiers_of(meta: android_activity::input::MetaState) -> crate::keyboard::ModifiersState {
+    use crate::keyboard::ModifiersState;
+    let mut state = ModifiersState::empty();
+    if meta.shift_on() {
+        state |= ModifiersState::SHIFT;
+    }
+    if meta.ctrl_on() {
+        state |= ModifiersState::CONTROL;
+    }
+    if meta.alt_on() {
+        state |= ModifiersState::ALT;
+    }
+    if meta.meta_on() {
+        state |= ModifiersState::SUPER;
+    }
+    state
+}
